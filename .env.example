# Copy to .env.local and fill in. Never commit .env.local.
# Which provider the app uses: gemini (default) or anthropic
LLM_PROVIDER=gemini

# Google Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6
